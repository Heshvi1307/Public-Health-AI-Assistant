# ==============================================================================
# Public Health Information Assistant - Environment Variables
# ==============================================================================

# LLM Provider: 'gemini', 'openai', 'groq', or leave empty for offline clinical simulation
LLM_PROVIDER=gemini

# API Keys (Provide one for live generation, or leave empty for offline simulation mode)
GEMINI_API_KEY=
LLM_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Rate Limiting (Requests per IP per minute)
RATE_LIMIT_PER_MINUTE=60

# Application Server Host & Port
APP_HOST=0.0.0.0
APP_PORT=8000
